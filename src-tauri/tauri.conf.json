{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StaySound",
  "version": "1.0.0",
  "identifier": "com.staysound.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "title": "StaySound",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/staysound-soulseek-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 170, "y": 168 },
        "applicationFolderPosition": { "x": 490, "y": 168 }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzQjBDNTkyMjIyQUI4NTMKUldSVHVDb2lrc1d3RTRnMVBtQ1FEWERmaEQyZHNWeGNLSC84b1ZTQkM1ejcrQng0d04rbkdoSlgK",
      "endpoints": [
        "https://github.com/Jakeblacklds/staysound-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
