{
  "name": "staysound",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:dev": "cross-env APP_VARIANT=development expo run:android",
    "android:build:debug": "node ./scripts/build-android.mjs --variant development --task app:assembleDevDebug",
    "android:build:release": "node ./scripts/build-android.mjs --variant production --arch arm64-v8a --task app:assembleProdRelease",
    "android:build:release:legacy": "node ./scripts/build-android.mjs --variant production --arch armeabi-v7a --task app:assembleProdRelease",
    "android:publish:release": "node ./scripts/publish-android-release.mjs",
    "ios": "expo run:ios",
    "ota:publish:development": "npx eas update --channel development",
    "ota:publish:production": "npx eas update --channel production",
    "web": "vite --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "web:soulseek": "node ./scripts/staysound-soulseek-bridge.mjs",
    "ios:soulseek": "cross-env STAYSOUND_SOULSEEK_BRIDGE_HOST=0.0.0.0 node ./scripts/staysound-soulseek-bridge.mjs",
    "web:local": "node ./scripts/staysound-web-local.mjs",
    "desktop:sidecar": "node ./scripts/build-soulseek-sidecar.mjs",
    "desktop:dev": "npm run desktop:sidecar && tauri dev",
    "desktop:build": "npm run desktop:sidecar && tauri build",
    "expo:web": "expo start --web",
    "video:remotion": "remotion studio remotion/Root.tsx",
    "video:render": "remotion render remotion/Root.tsx StaySoundPromo out/staysound-feature-tour-vertical.mp4",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@material/material-color-utilities": "^0.4.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uimaxbai/am-lyrics": "^1.5.6",
    "@xmldom/xmldom": "^0.8.11",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-blur": "^15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-media-library": "~18.2.1",
    "expo-music-info-2": "^2.0.0",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "karaoke-view": "file:./modules/karaoke-view",
    "library-indexer": "file:./modules/library-indexer",
    "music-metadata-browser": "^2.5.11",
    "ogl": "^1.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-colors": "^2.5.1",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-track-player": "^5.0.0-alpha0-nightly-359af5a12d712d3b685530aed9b9625865a25d74",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.7.2",
    "reanimated-color-picker": "^4.2.0",
    "remotion": "^4.0.173",
    "slsk-client": "^1.1.0",
    "soulseek-native": "file:./modules/soulseek-native",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.441",
    "@tauri-apps/cli": "2.11.4",
    "@types/base-64": "^1.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.1.0",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "^5.1.2",
    "@yao-pkg/pkg": "6.21.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.1",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.3.0"
  },
  "overrides": {
    "expo-music-info-2": {
      "expo-file-system": "~19.0.21"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player",
          "karaoke-view",
          "library-indexer",
          "soulseek-native"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
