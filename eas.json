{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDevDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProdRelease"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "gradleCommand": ":app:assembleProdRelease"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
