+        require(items.isNotEmpty() && startIndex in items.indices)
+        val mediaItems = items.map { it.toMediaItem() }
+        val sameQueue = queue.size == mediaItems.size && queue.zip(mediaItems).all { (a, b) ->
+            a.mediaId == b.mediaId && a.localConfiguration?.uri == b.localConfiguration?.uri
+        }
+        if (sameQueue) {
+            exoPlayer.seekTo(startIndex, 0L)
+        } else {
+            queue.clear()
+            queue.addAll(mediaItems)
