+package com.doublesymmetry.trackplayer.utils
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.database.MatrixCursor
+import android.net.Uri
+import android.os.ParcelFileDescriptor
+import android.provider.OpenableColumns
+import java.io.File
+import java.io.FileNotFoundException
+
+/**
+ * Serves app-private artwork files as content:// URIs.
+ *
+ * Android Auto renders some surfaces (the split-screen media card, browse
+ * lists) from the artwork URI in its own process, where file:// paths into our
+ * cache are unreadable. Read-only, and limited to image files inside the app's
+ * own storage directories.
+ */
+class StaySoundArtworkProvider : ContentProvider() {
+
+    override fun onCreate(): Boolean {
+        val ctx = context ?: return false
+        authority = "${ctx.packageName}$AUTHORITY_SUFFIX"
+        roots = listOfNotNull(
+            ctx.cacheDir,
+            ctx.filesDir,
+            ctx.externalCacheDir,
+            ctx.getExternalFilesDir(null)
+        ).mapNotNull { runCatching { it.canonicalPath }.getOrNull() }
+        return true
+    }
+
+    override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor {
+        if (mode != "r") throw FileNotFoundException("Artwork is read-only: $uri")
+        val file = resolveFile(uri) ?: throw FileNotFoundException("Unknown artwork: $uri")
+        return ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)
+    }
+
+    override fun getType(uri: Uri): String? {
+        return resolveFile(uri)?.let { MIME_TYPES[it.extension.lowercase()] }
+    }
+
+    override fun query(
+        uri: Uri,
+        projection: Array<out String>?,
+        selection: String?,
+        selectionArgs: Array<out String>?,
+        sortOrder: String?
+    ): Cursor? {
+        val file = resolveFile(uri) ?: return null
+        val columns = projection ?: arrayOf(OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE)
+        return MatrixCursor(columns, 1).apply {
+            addRow(columns.map { column ->
+                when (column) {
+                    OpenableColumns.DISPLAY_NAME -> file.name
+                    OpenableColumns.SIZE -> file.length()
+                    else -> null
+                }
+            })
+        }
+    }
+
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+
+    override fun update(
+        uri: Uri,
+        values: ContentValues?,
+        selection: String?,
+        selectionArgs: Array<out String>?
+    ): Int = 0
+
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?): Int = 0
+
+    private fun resolveFile(uri: Uri): File? {
+        val segments = uri.pathSegments
+        if (segments.size != 2 || segments[0] != PATH_PREFIX) return null
+        return shareableFile(segments[1])
+    }
+
+    companion object {
+        private const val AUTHORITY_SUFFIX = ".staysound.artwork"
+        private const val PATH_PREFIX = "file"
+        private val MIME_TYPES = mapOf(
+            "jpg" to "image/jpeg",
+            "jpeg" to "image/jpeg",
+            "png" to "image/png",
+            "webp" to "image/webp",
+            "gif" to "image/gif",
+            "bmp" to "image/bmp"
+        )
+
+        @Volatile
+        private var authority: String? = null
+
+        @Volatile
+        private var roots: List<String> = emptyList()
+
+        private fun shareableFile(path: String): File? {
+            val file = runCatching { File(path).canonicalFile }.getOrNull() ?: return null
+            if (file.extension.lowercase() !in MIME_TYPES) return null
+            if (roots.none { file.path.startsWith("$it${File.separator}") }) return null
+            return file.takeIf { it.isFile }
+        }
+
+        /**
+         * Rewrites a file:// (or bare path) artwork reference into this
+         * provider's content:// form. Anything else is returned untouched.
+         */
+        @JvmStatic
+        fun toShareableUri(artwork: String?): String? {
+            if (artwork.isNullOrBlank()) return artwork
+            val currentAuthority = authority ?: return artwork
+
+            val path = when {
+                artwork.startsWith("/") -> artwork
+                artwork.startsWith("file://", ignoreCase = true) -> Uri.parse(artwork).path
+                else -> null
+            } ?: return artwork
+
+            val file = shareableFile(path) ?: return artwork
+            return Uri.Builder()
+                .scheme("content")
+                .authority(currentAuthority)
+                .appendPath(PATH_PREFIX)
+                .appendPath(file.path)
+                .build()
+                .toString()
+        }
+    }
+}
