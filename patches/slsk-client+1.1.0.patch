+function streamFromOffset (socket, upload, offsetBuffer) {
+  const low = offsetBuffer.readUInt32LE(0)
+  const high = offsetBuffer.readUInt32LE(4)
+  const offset = low + (high * 0x100000000)
+  if (offset >= upload.size) return
+  const input = fs.createReadStream(upload.path, { start: offset })
+  input.on('error', () => socket.destroy())
+  input.pipe(socket, { end: false })
+}
